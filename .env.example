# From @BotFather (/newbot). Paste it here yourself; never share it in chat.
TELEGRAM_BOT_TOKEN=
# Telegram user ids that get answers, comma or space separated (@userinfobot tells you yours).
# The bot logs the id of everyone it ignores.
ALLOWED_USER_IDS=

# Where audio is transcribed.
#   openrouter: OpenRouter's JSON API (asks for providers that don't keep your audio). Needs a key.
#   openai:     the OpenAI multipart API, spoken by OpenAI itself and by local servers.
TRANSCRIBE_API=openrouter
# Empty means https://openrouter.ai/api/v1. Local server from docker-compose.yml: http://whisper:9000/v1
TRANSCRIBE_BASE_URL=
# https://openrouter.ai/keys for OpenRouter. Leave empty for a local server without auth.
TRANSCRIBE_API_KEY=
# The default model; /model in Telegram overrides it until /model reset.
# OpenRouter ids: https://openrouter.ai/api/v1/models?output_modalities=transcription
TRANSCRIBE_MODEL=elevenlabs/scribe-v2

# Where the /model choice is saved. The Docker image keeps it in /app/data (a volume).
DATA_DIR=data
